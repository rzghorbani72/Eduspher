# Example: Alpine + Hamravesh mirrors (apk + npm)
# Rename to Dockerfile only if you switch the base image to node:*-alpine

FROM node:22-alpine AS base

ENV NPM_REGISTRY=https://repo.hmirror.ir/npm/
ENV npm_config_registry=${NPM_REGISTRY}
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://repo.hmirror.ir/apk|g' /etc/apk/repositories \
  && apk add --no-cache libc6-compat \
  && corepack enable \
  && corepack prepare pnpm@9 --activate \
  && npm config set registry "${NPM_REGISTRY}" \
  && pnpm config set registry "${NPM_REGISTRY}"

WORKDIR /app
